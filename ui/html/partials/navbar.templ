package partials

templ NavBar(isAuthenticated bool, csrfToken string){
    <header class="site-header">
        <div class="header-container">
            <!-- Left: Brand + Navigation Links -->
            <div class="header-left">
                <a href="/markets" class="header-brand-link">
                    <img src="/static/images/logo.png" alt="Zaraba" class="header-brand-logo"/>
                    <span>Zaraba</span>
                </a>
                <nav class="header-nav header-nav--desktop">
                    <a href="/markets" class="header-nav-link">Markets</a>
                    <a href="/trade/bitcoin" class="header-nav-link">Trade</a>
                    if isAuthenticated {
                        <a href="/user/wallet" class="header-nav-link">Wallet</a>
                        <a href="/orders" class="header-nav-link">Orders</a>
                    }
                </nav>
            </div>

            <!-- Right: Action Buttons -->
            <div class="header-actions">
                if isAuthenticated {
                    <div class="profile-popover-wrap header-actions--desktop">
                        <button class="avatar-trigger" aria-label="Profile menu">
                            <span class="avatar avatar--sm" data-color={ GetAvatarColor(ctx) }>
                                { GetInitials(ctx) }
                            </span>
                        </button>
                        <div class="popover popover--profile">
                            <div class="popover-header">
                                <div class="popover-header-row">
                                    <span class="avatar avatar--md" data-color={ GetAvatarColor(ctx) }>
                                        { GetInitials(ctx) }
                                    </span>
                                    <div class="popover-header-info">
                                        <p class="popover-title">{ GetUserName(ctx) }</p>
                                        <p class="popover-description">{ GetUserEmail(ctx) }</p>
                                    </div>
                                </div>
                            </div>
                            <div class="popover-body">
                                <a href="/user/wallet" class="popover-link">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2.5"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/></svg>
                                    <span>Wallet</span>
                                </a>
                                <a href="/orders" class="popover-link">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5h11"/><path d="M9 12h11"/><path d="M9 19h11"/><path d="M3 5h.01"/><path d="M3 12h.01"/><path d="M3 19h.01"/></svg>
                                    <span>Orders</span>
                                </a>
                            </div>
                            <div class="popover-footer">
                                <form action="/user/logout" method="POST" class="header-logout-form">
                                    <input type="hidden" name="csrf_token" value={ csrfToken }/>
                                    <button type="submit" class="btn btn-outline btn-sm btn-block">Sign Out</button>
                                </form>
                            </div>
                        </div>
                    </div>
                } else {
                    <div class="magnetic-wrap">
                        <a href="/user/login" class="btn btn-outline btn-sm">Sign in</a>
                    </div>
                    <div class="magnetic-wrap">
                        <a href="/user/signup" class="btn btn-primary btn-sm">Get started</a>
                    </div>
                }
            </div>

            <!-- Mobile: Hamburger Toggle -->
            <button class="header-mobile-toggle" onclick="document.querySelector('.header-mobile-menu').classList.toggle('is-open'); this.classList.toggle('is-active')" aria-label="Toggle menu">
                <svg class="icon-menu" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
                <svg class="icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </button>
        </div>

        <!-- Mobile Menu Dropdown -->
        <div class="header-mobile-menu">
            <div class="header-mobile-menu-inner">
                if isAuthenticated {
                    <div class="mobile-profile-header">
                        <span class="avatar avatar--md" data-color={ GetAvatarColor(ctx) }>
                            { GetInitials(ctx) }
                        </span>
                        <div>
                            <p class="mobile-profile-name">{ GetUserName(ctx) }</p>
                            <p class="mobile-profile-email">{ GetUserEmail(ctx) }</p>
                        </div>
                    </div>
                    <div class="mobile-nav-divider"></div>
                }
                <a href="/markets" class="mobile-nav-link">
                    <span>Markets</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
                <a href="/trade/bitcoin" class="mobile-nav-link">
                    <span>Trade</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
                if isAuthenticated {
                    <a href="/user/wallet" class="mobile-nav-link">
                        <span>Wallet</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </a>
                    <a href="/orders" class="mobile-nav-link">
                        <span>Orders</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </a>
                    <div class="mobile-menu-actions">
                        <form action="/user/logout" method="POST">
                            <input type="hidden" name="csrf_token" value={ csrfToken }/>
                            <button type="submit" class="btn btn-outline btn-block">Sign Out</button>
                        </form>
                    </div>
                } else {
                    <div class="mobile-menu-actions">
                        <a href="/user/login" class="btn btn-outline btn-block">Sign in</a>
                        <a href="/user/signup" class="btn btn-primary btn-block">Get started</a>
                    </div>
                }
            </div>
        </div>
    </header>
    if isAuthenticated {
        <div class="popover-backdrop" id="popover-backdrop"></div>
    }
}