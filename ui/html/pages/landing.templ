package pages

import "github.com/kayden-vs/zaraba/ui/html"

templ LandingPage(flash string, isAuthenticated bool, csrfToken string) {
	@html.Base("Welcome", flash, isAuthenticated, csrfToken, LandingContent())
}

templ LandingContent() {
	<div class="landing-page">

		<!-- ============================================================
		     HERO SECTION - Full viewport with gradient-dots background
		     ============================================================ -->
		<section class="landing-hero" id="landing-hero">
			<div class="landing-hero__gradient-dots"></div>

			<!-- Particle typography section -->
			<div class="landing-hero__particles"
				id="particles-container"
				data-text="ZARABA"
				data-font-size="160"
				data-density="5"
				data-dispersion="20"
				data-color="#cba6f7">
				<canvas id="particles-canvas" class="landing-hero__particles-canvas"></canvas>
			</div>

			<!-- Hero content overlay -->
			<div class="landing-hero__content">
				<div class="landing-hero__badge">
					<span class="landing-hero__badge-dot"></span>
					Trading engine live
				</div>

				<h1 class="landing-hero__title">
					The Future of
					<span class="landing-hero__title-accent">Crypto Trading</span>
				</h1>

				<p class="landing-hero__subtitle">
					Lightning-fast order matching, institutional-grade security,
					and an engine built for precision. Trade with confidence.
				</p>

				<div class="landing-hero__actions">
					<a href="/user/signup" class="rainbow-btn">
						Start Trading
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
					</a>
					<a href="/markets" class="btn btn-lg landing-hero__cta landing-hero__cta--outline">
						Explore Markets
					</a>
				</div>

				<div class="landing-hero__scroll-hint">
					<span>Scroll to explore</span>
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
				</div>
			</div>
		</section>

		<!-- ============================================================
		     MARQUEE STATS BAR
		     ============================================================ -->
		<section class="landing-marquee">
			<div class="landing-marquee__track">
				<div class="landing-marquee__content">
					<div class="landing-marquee__item">
						<span class="landing-marquee__value">$2.4B+</span>
						<span class="landing-marquee__label">Trading Volume</span>
						<span class="landing-marquee__emoji">🚀</span>
					</div>
					<div class="landing-marquee__item">
						<span class="landing-marquee__value">50+</span>
						<span class="landing-marquee__label">Trading Pairs</span>
						<span class="landing-marquee__emoji">📈</span>
					</div>
					<div class="landing-marquee__item">
						<span class="landing-marquee__value">&lt;10ms</span>
						<span class="landing-marquee__label">Order Latency</span>
						<span class="landing-marquee__emoji">⚡</span>
					</div>
					<div class="landing-marquee__item">
						<span class="landing-marquee__value">99.99%</span>
						<span class="landing-marquee__label">Uptime SLA</span>
						<span class="landing-marquee__emoji">🛡️</span>
					</div>
					<div class="landing-marquee__item">
						<span class="landing-marquee__value">150K+</span>
						<span class="landing-marquee__label">Active Traders</span>
						<span class="landing-marquee__emoji">👥</span>
					</div>
					<div class="landing-marquee__item">
						<span class="landing-marquee__value">$0</span>
						<span class="landing-marquee__label">Maker Fees</span>
						<span class="landing-marquee__emoji">💰</span>
					</div>
				</div>
				<!-- Duplicate for seamless loop -->
				<div class="landing-marquee__content" aria-hidden="true">
					<div class="landing-marquee__item">
						<span class="landing-marquee__value">$2.4B+</span>
						<span class="landing-marquee__label">Trading Volume</span>
						<span class="landing-marquee__emoji">🚀</span>
					</div>
					<div class="landing-marquee__item">
						<span class="landing-marquee__value">50+</span>
						<span class="landing-marquee__label">Trading Pairs</span>
						<span class="landing-marquee__emoji">📈</span>
					</div>
					<div class="landing-marquee__item">
						<span class="landing-marquee__value">&lt;10ms</span>
						<span class="landing-marquee__label">Order Latency</span>
						<span class="landing-marquee__emoji">⚡</span>
					</div>
					<div class="landing-marquee__item">
						<span class="landing-marquee__value">99.99%</span>
						<span class="landing-marquee__label">Uptime SLA</span>
						<span class="landing-marquee__emoji">🛡️</span>
					</div>
					<div class="landing-marquee__item">
						<span class="landing-marquee__value">150K+</span>
						<span class="landing-marquee__label">Active Traders</span>
						<span class="landing-marquee__emoji">👥</span>
					</div>
					<div class="landing-marquee__item">
						<span class="landing-marquee__value">$0</span>
						<span class="landing-marquee__label">Maker Fees</span>
						<span class="landing-marquee__emoji">💰</span>
					</div>
				</div>
			</div>
		</section>

		<!-- ============================================================
		     GLOBAL NETWORK SECTION - Interactive Globe
		     ============================================================ -->
		<section class="landing-globe landing-reveal">
			<div class="landing-globe__inner">
				<!-- Left: Content -->
				<div class="landing-globe__content">
					<div class="landing-section-badge">
						<span class="landing-section-badge__dot"></span>
						Global Infrastructure
					</div>

					<h2 class="landing-globe__title">
						Trade Across
						<span class="landing-globe__title-accent">The Globe</span>
					</h2>

					<p class="landing-globe__desc">
						Our matching engine is deployed across strategic points worldwide.
						Your orders are executed from the nearest node with sub-10ms latency.
						Drag the globe to explore our network.
					</p>

					<div class="landing-globe__stats">
						<div class="landing-globe__stat">
							<span class="landing-globe__stat-value" data-count-to="12" data-count-suffix="+">0+</span>
							<span class="landing-globe__stat-label">Global Nodes</span>
						</div>
						<div class="landing-globe__stat-divider"></div>
						<div class="landing-globe__stat">
							<span class="landing-globe__stat-value">&lt;10ms</span>
							<span class="landing-globe__stat-label">Avg Latency</span>
						</div>
						<div class="landing-globe__stat-divider"></div>
						<div class="landing-globe__stat">
							<span class="landing-globe__stat-value" data-count-to="99.99" data-count-suffix="%" data-count-decimals="2">0%</span>
							<span class="landing-globe__stat-label">Uptime</span>
						</div>
					</div>
				</div>

				<!-- Right: Globe -->
				<div class="landing-globe__canvas-wrap">
					<canvas id="globe-canvas" class="landing-globe__canvas" style="width:460px;height:460px;cursor:grab;"></canvas>
				</div>
			</div>
		</section>

		<!-- ============================================================
		     FEATURES GRID
		     ============================================================ -->
		<section class="landing-features">
			<div class="landing-features__header landing-reveal">
				<div class="landing-section-badge">
					<span class="landing-section-badge__dot"></span>
					Why Zaraba
				</div>
				<h2 class="landing-features__title">
					Built for Serious
					<span class="landing-features__title-accent">Traders</span>
				</h2>
				<p class="landing-features__subtitle">
					Every component engineered for performance, security, and reliability.
				</p>
			</div>

			<div class="landing-features__grid">
				<!-- Feature 1: Matching Engine -->
				<div class="landing-feature-card landing-reveal">
					<div class="landing-feature-card__icon landing-feature-card__icon--mauve">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
					</div>
					<h3 class="landing-feature-card__title">Lightning Engine</h3>
					<p class="landing-feature-card__desc">
						Custom-built order matching engine processes millions of orders per second
						with deterministic price-time priority.
					</p>
				</div>

				<!-- Feature 2: Security -->
				<div class="landing-feature-card landing-reveal">
					<div class="landing-feature-card__icon landing-feature-card__icon--green">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
					</div>
					<h3 class="landing-feature-card__title">Bank-Grade Security</h3>
					<p class="landing-feature-card__desc">
						Multi-layer encryption, cold storage for 95% of assets, and real-time
						threat monitoring protect every transaction.
					</p>
				</div>

				<!-- Feature 3: Low Fees -->
				<div class="landing-feature-card landing-reveal">
					<div class="landing-feature-card__icon landing-feature-card__icon--sky">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 18V6"/></svg>
					</div>
					<h3 class="landing-feature-card__title">Zero Maker Fees</h3>
					<p class="landing-feature-card__desc">
						Maker orders trade free. Taker fees start at 0.1% and decrease
						with volume — the best rates in the industry.
					</p>
				</div>

				<!-- Feature 4: Real-time Data -->
				<div class="landing-feature-card landing-reveal">
					<div class="landing-feature-card__icon landing-feature-card__icon--teal">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
					</div>
					<h3 class="landing-feature-card__title">Real-Time Streaming</h3>
					<p class="landing-feature-card__desc">
						Live orderbook depth, trade tickers, and candlestick data streamed
						via SSE — no polling, no delays.
					</p>
				</div>

				<!-- Feature 5: Advanced Charts -->
				<div class="landing-feature-card landing-reveal">
					<div class="landing-feature-card__icon landing-feature-card__icon--pink">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
					</div>
					<h3 class="landing-feature-card__title">TradingView Charts</h3>
					<p class="landing-feature-card__desc">
						Professional-grade charting with 100+ indicators, drawing tools,
						and multi-timeframe analysis built right in.
					</p>
				</div>

				<!-- Feature 6: API -->
				<div class="landing-feature-card landing-reveal">
					<div class="landing-feature-card__icon landing-feature-card__icon--yellow">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/></svg>
					</div>
					<h3 class="landing-feature-card__title">gRPC & REST API</h3>
					<p class="landing-feature-card__desc">
						Full-featured APIs for algorithmic traders. gRPC for ultra-low latency,
						REST for broad compatibility.
					</p>
				</div>
			</div>
		</section>

		<!-- ============================================================
		     CTA SECTION
		     ============================================================ -->
		<section class="landing-cta landing-reveal">
			<div class="landing-cta__bg"></div>
			<div class="landing-cta__inner">
				<h2 class="landing-cta__title">Ready to Trade?</h2>
				<p class="landing-cta__desc">
					Join thousands of traders who trust Zaraba for fast, secure crypto trading.
					Create your account in seconds.
				</p>
				<div class="landing-cta__actions">
					<a href="/user/signup" class="rainbow-btn">
						Create Free Account
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
					</a>
					<a href="/trade/bitcoin" class="btn btn-lg landing-hero__cta landing-hero__cta--outline">
						Try Demo Trading
					</a>
				</div>
			</div>
		</section>

		<!-- ============================================================
		     FOOTER
		     ============================================================ -->
		<footer class="landing-footer">
			<div class="landing-footer__inner">
				<!-- Brand Column -->
				<div class="landing-footer__brand">
					<div class="landing-footer__logo">
						<span class="header-brand-mark"></span>
						<span class="landing-footer__logo-text">Zaraba</span>
					</div>
					<p class="landing-footer__desc">
						A professional cryptocurrency exchange platform built for traders
						who demand precision, speed, and reliability.
					</p>
				</div>

				<!-- Quick Links -->
				<div class="landing-footer__col">
					<h4 class="landing-footer__col-title">Platform</h4>
					<ul class="landing-footer__links">
						<li><a href="/markets">Markets</a></li>
						<li><a href="/trade/bitcoin">Trade</a></li>
						<li><a href="/user/wallet">Wallet</a></li>
						<li><a href="/user/signup">Create Account</a></li>
					</ul>
				</div>

				<!-- Resources -->
				<div class="landing-footer__col">
					<h4 class="landing-footer__col-title">Resources</h4>
					<ul class="landing-footer__links">
						<li><a href="/markets">API Documentation</a></li>
						<li><a href="/markets">Trading Guide</a></li>
						<li><a href="/markets">Fee Schedule</a></li>
						<li><a href="/markets">System Status</a></li>
					</ul>
				</div>

				<!-- Social / Follow Us -->
				<div class="landing-footer__col">
					<h4 class="landing-footer__col-title">Connect</h4>
					<div class="landing-social">
						<!-- Instagram -->
						<a href="https://instagram.com/yeagariist" target="_blank" rel="noopener noreferrer" class="landing-social__link" aria-label="Instagram">
							<svg viewBox="0 0 24 24" fill="currentColor" class="landing-social__icon">
								<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
							</svg>
							<span class="landing-social__tooltip">
								Instagram
								<span class="landing-social__tooltip-arrow"></span>
							</span>
						</a>
						<!-- GitHub -->
						<a href="https://github.com/kayden-vs" target="_blank" rel="noopener noreferrer" class="landing-social__link" aria-label="GitHub">
							<svg viewBox="0 0 24 24" fill="currentColor" class="landing-social__icon">
								<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
							</svg>
							<span class="landing-social__tooltip">
								GitHub
								<span class="landing-social__tooltip-arrow"></span>
							</span>
						</a>
						<!-- LinkedIn -->
						<a href="https://www.linkedin.com/in/rohit-roy-vs/" target="_blank" rel="noopener noreferrer" class="landing-social__link" aria-label="LinkedIn">
							<svg viewBox="0 0 24 24" fill="currentColor" class="landing-social__icon">
								<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
							</svg>
							<span class="landing-social__tooltip">
								LinkedIn
								<span class="landing-social__tooltip-arrow"></span>
							</span>
						</a>
					</div>
				</div>
			</div>

			<!-- Bottom bar -->
			<div class="landing-footer__bottom">
				<span class="landing-footer__copyright">© 2026 Zaraba Exchange. All rights reserved.</span>
				<div class="landing-footer__bottom-links">
					<a href="/markets">Privacy Policy</a>
					<a href="/markets">Terms of Service</a>
				</div>
			</div>
		</footer>

		<!-- Landing page scripts -->
		<script src="/static/js/landing.js"></script>
		<script src="/static/js/particles.js"></script>
		<script src="/static/js/globe.js"></script>
	</div>
}
