package pages

import "github.com/kayden-vs/zaraba/ui/html"

templ NotFoundPage(flash string, isAuthenticated bool, csrfToken string) {
	@html.Base("404 - Not Found", flash, isAuthenticated, csrfToken, NotFoundContent())
}

templ NotFoundContent() {
	<div class="nf-root">
		<div class="nf-empty">
			<div class="nf-header">
				<div class="nf-title">404</div>
				<p class="nf-description">
					The page you're looking for might have been <br/>
					moved or doesn't exist.
				</p>
			</div>
			<div class="nf-content">
				<div class="nf-actions">
					<a href="/" class="nf-btn nf-btn--primary">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
							<polyline points="9 22 9 12 15 12 15 22"></polyline>
						</svg>
						Go Home
					</a>
					<a href="/markets" class="nf-btn nf-btn--outline">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"></circle>
							<polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
						</svg>
						Explore
					</a>
				</div>
			</div>
		</div>
	</div>
}
