package pages

import "github.com/kayden-vs/zaraba/ui/html"

type PasswordFormParams struct{
    CurrentPassword string
    NewPassword string
    ConfirmPassword string
    FieldErrors map[string]string
    CSRFToken string
}

templ PasswordPage(props PasswordFormParams, isAuthenticated bool){
    @html.Base("Change Password", "", isAuthenticated, props.CSRFToken, Password(props))
}

templ Password(form PasswordFormParams) {
    <div class="account-container">
        <div class="account-header">
            <h2>Change Password</h2>
        </div>

        <div class="card">
            <div class="card-body">
                <form action="/account/password/update" method="POST" novalidate class="password-form">
                    <input type="hidden" name="csrf_token" value={ form.CSRFToken }/>
                    
                    <div class="form-group">
                        <label for="currentPassword">Current Password</label>
                        if err, ok := form.FieldErrors["currentPassword"]; ok {
                            <span class="error">{ err }</span>
                        }
                        <input type="password" id="currentPassword" name="currentPassword" value={ form.CurrentPassword } autocomplete="current-password"/>
                    </div>
                    
                    <div class="form-group">
                        <label for="newPassword">New Password</label>
                        if err, ok := form.FieldErrors["newPassword"]; ok {
                            <span class="error">{ err }</span>
                        }
                        <input type="password" id="newPassword" name="newPassword" value={ form.NewPassword } autocomplete="new-password"/>
                    </div>
                    
                    <div class="form-group">
                        <label for="newPasswordConfirmation">Confirm New Password</label>
                        if err, ok := form.FieldErrors["confirmPassword"]; ok {
                            <span class="error">{ err }</span>
                        }
                        <input type="password" id="newPasswordConfirmation" name="newPasswordConfirmation" value={ form.ConfirmPassword } autocomplete="new-password"/>
                    </div>
                    
                    <div class="form-group">
                        <input type="submit" value="Update Password"/>
                    </div>
                </form>
            </div>
        </div>

        <div class="mt-4">
            <a href="/account/view" class="btn btn-ghost">← Back to Account</a>
        </div>
    </div>
}