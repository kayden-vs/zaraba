package pages

import "fmt"
import "strings"

import "github.com/kayden-vs/zaraba/internal/engine"
import "github.com/kayden-vs/zaraba/ui/html"

templ OrdersPage(props OrdersPageProps, flash string, isAuthenticated bool, csrfToken string) {
	@html.Base("Orders", flash, isAuthenticated, csrfToken, OrdersBody(props, csrfToken))
}

templ OrdersBody(props OrdersPageProps, csrfToken string) {
	<div class="orders-page">
		<div class="orders-header">
			<div>
				<h1>Orders</h1>
				<p>Track active and completed orders with fill progress, execution metrics, and P/L.</p>
			</div>
			<a href="/trade/bitcoin" class="btn btn-primary">New Order</a>
		</div>

		<div class="orders-summary-grid">
			<div class="orders-summary-card">
				<span class="orders-summary-label">Active Orders</span>
				<span class="orders-summary-value mono">{ fmt.Sprintf("%d", props.Summary.ActiveOrders) }</span>
			</div>
			<div class="orders-summary-card">
				<span class="orders-summary-label">Filled Orders</span>
				<span class="orders-summary-value mono">{ fmt.Sprintf("%d", props.Summary.FilledOrders) }</span>
			</div>
			<div class="orders-summary-card">
				<span class="orders-summary-label">Cancelled</span>
				<span class="orders-summary-value mono">{ fmt.Sprintf("%d", props.Summary.CancelledOrders) }</span>
			</div>
			<div class="orders-summary-card">
				<span class="orders-summary-label">Unrealized P/L</span>
				<span class={ "orders-summary-value mono " + pnlClass(props.Summary.TotalUnrealizedPnL) }>
					{ engine.FormatPrice(props.Summary.TotalUnrealizedPnL) }
				</span>
			</div>
		</div>

		<div class="orders-tabs" role="tablist">
			<a href="/orders?tab=active" class={ "orders-tab" + activeTabClass(props.ActiveTab, "active") } role="tab" aria-selected={ fmt.Sprintf("%t", isActiveTab(props.ActiveTab, "active")) }>Active</a>
			<a href="/orders?tab=completed" class={ "orders-tab" + activeTabClass(props.ActiveTab, "completed") } role="tab" aria-selected={ fmt.Sprintf("%t", isActiveTab(props.ActiveTab, "completed")) }>Completed</a>
			<a href="/orders?tab=all" class={ "orders-tab" + activeTabClass(props.ActiveTab, "all") } role="tab" aria-selected={ fmt.Sprintf("%t", isActiveTab(props.ActiveTab, "all")) }>All</a>
		</div>

		if len(props.Orders) == 0 {
			<div class="orders-empty">
				<h3>No orders in this view</h3>
				<p>Place your first trade to start tracking fills, execution price, and P/L.</p>
				<a href="/trade/bitcoin" class="btn btn-primary">Go to Trade</a>
			</div>
		} else {
			<div class="orders-table-wrap">
				<table class="orders-table">
					<thead>
						<tr>
							<th>Pair</th>
							<th>Side</th>
							<th>Type</th>
							<th>Status</th>
							<th>Limit Price</th>
							<th>Avg Fill</th>
							<th>Last Price</th>
							<th>Quantity</th>
							<th>Filled</th>
							<th>Remaining</th>
							<th>Filled Value</th>
							<th>P/L</th>
							<th>Updated</th>
							<th>Action</th>
						</tr>
					</thead>
					<tbody>
						for _, row := range props.Orders {
							<tr>
								<td>
									<div class="orders-pair-cell">
										<span class="orders-pair">{ row.Pair }</span>
										<span class="orders-id mono">#{ fmt.Sprintf("%d", row.ID) }</span>
									</div>
								</td>
								<td><span class={ "orders-chip " + orderSideClass(row.Side) }>{ row.Side }</span></td>
								<td><span class={ "orders-chip " + orderTypeClass(row.OrderType) }>{ row.OrderType }</span></td>
								<td><span class={ "orders-chip " + orderStatusClass(row.Status) }>{ prettyStatus(row.Status) }</span></td>
								<td class="mono">{ engine.FormatPrice(row.Price) }</td>
								<td class="mono">
									if row.AvgFillPrice > 0 {
										{ engine.FormatPrice(row.AvgFillPrice) }
									} else {
										<span class="orders-dash">-</span>
									}
								</td>
								<td class="mono">
									if row.LastPrice > 0 {
										{ engine.FormatPrice(row.LastPrice) }
									} else {
										<span class="orders-dash">-</span>
									}
								</td>
								<td class="mono">{ engine.FormatQuantity(row.Quantity) }</td>
								<td>
									<div class="orders-filled-cell">
										<span class="mono">{ engine.FormatQuantity(row.Filled) } ({ fmt.Sprintf("%.2f%%", row.FillPercent) })</span>
										<div class="orders-fill-track">
											<div class="orders-fill-bar" style={ fmt.Sprintf("width: %.2f%%", row.FillPercent) }></div>
										</div>
									</div>
								</td>
								<td class="mono">{ engine.FormatQuantity(row.Remaining) }</td>
								<td class="mono">{ engine.FormatPrice(row.FilledNotional) }</td>
								<td>
									if row.HasPnL {
										<div class="orders-pnl-cell">
											<span class={ "mono " + pnlClass(row.UnrealizedPnL) }>{ engine.FormatPrice(row.UnrealizedPnL) }</span>
											<span class={ "mono " + pnlClass(row.UnrealizedPnL) }>{ fmt.Sprintf("(%.2f%%)", row.UnrealizedPnLPct) }</span>
										</div>
									} else {
										<span class="orders-dash">-</span>
									}
								</td>
								<td class="mono">{ row.UpdatedAt.Format("02 Jan 15:04") }</td>
								<td>
									if row.CanCancel {
										<form action={ fmt.Sprintf("/orders/%d/cancel", row.ID) } method="POST" class="orders-cancel-form">
											<input type="hidden" name="csrf_token" value={ csrfToken }/>
											<button type="submit" class="btn btn-outline btn-sm">Cancel</button>
										</form>
									} else {
										<span class="orders-dash">-</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

func isActiveTab(current, target string) bool {
	return strings.EqualFold(strings.TrimSpace(current), strings.TrimSpace(target))
}

func activeTabClass(current, target string) string {
	if isActiveTab(current, target) {
		return " is-active"
	}
	return ""
}

func orderSideClass(side string) string {
	if strings.EqualFold(side, "BUY") {
		return "orders-chip--buy"
	}
	return "orders-chip--sell"
}

func orderTypeClass(orderType string) string {
	if strings.EqualFold(orderType, "MARKET") {
		return "orders-chip--market"
	}
	return "orders-chip--limit"
}

func orderStatusClass(status string) string {
	switch strings.ToUpper(strings.TrimSpace(status)) {
	case "FILLED":
		return "orders-chip--filled"
	case "PARTIALLY_FILLED":
		return "orders-chip--partial"
	case "CANCELLED":
		return "orders-chip--cancelled"
	default:
		return "orders-chip--open"
	}
}

func prettyStatus(status string) string {
	normalized := strings.ToUpper(strings.TrimSpace(status))
	if normalized == "PARTIALLY_FILLED" {
		return "PARTIAL"
	}
	return normalized
}

func pnlClass(value int64) string {
	if value > 0 {
		return "orders-pnl-positive"
	}
	if value < 0 {
		return "orders-pnl-negative"
	}
	return "orders-pnl-neutral"
}
