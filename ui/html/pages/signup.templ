package pages

import "github.com/kayden-vs/zaraba/ui/html"

type SignupFormParams struct {
	Name   string
	Email  string
	FieldErrors map[string]string
	CSRFToken string
}

templ SignupPage(props SignupFormParams, isAuthenticated bool){
	@html.Base("Sign Up", "", isAuthenticated, props.CSRFToken, Signup(props))
}

templ Signup(props SignupFormParams) {
	<div class="auth-container">
		<div class="auth-wrapper">
			<!-- Left: Visual/Branding Side -->
			<div class="auth-visual">
				<div class="auth-visual-content">
					<h2>Start trading with Zaraba</h2>
					<p>Create your account and join thousands of traders on our professional exchange platform.</p>
				</div>
				<div class="auth-decoration">
					<div class="decoration-bar"></div>
					<div class="decoration-bar"></div>
					<div class="decoration-bar"></div>
				</div>
			</div>

			<!-- Right: Form Side -->
			<div class="auth-form-section">
				<div class="auth-form-header">
					<h1>Create account</h1>
					<p>Fill in your details to get started</p>
				</div>

				<form action="/user/signup" method="POST" novalidate class="auth-form">
					<input type='hidden' name='csrf_token' value={ props.CSRFToken }/>
					
					<div class="form-group">
						<label for="name">Full Name</label>
						if props.FieldErrors["name"] != "" {
							<span class="error">{ props.FieldErrors["name"] }</span>
						}
						<input type="text" id="name" name="name" value={ props.Name } placeholder="John Doe" autocomplete="name"/>
					</div>
					
					<div class="form-group">
						<label for="email">Email Address</label>
						if props.FieldErrors["email"] != "" {
							<span class="error">{ props.FieldErrors["email"] }</span>
						}
						<input type="email" id="email" name="email" value={ props.Email } placeholder="you@example.com" autocomplete="email"/>
					</div>
					
					<div class="form-group">
						<label for="password">Password</label>
						if props.FieldErrors["password"] != "" {
							<span class="error">{ props.FieldErrors["password"] }</span>
						}
						<input type="password" id="password" name="password" placeholder="••••••••" autocomplete="new-password"/>
						<small class="text-tertiary">Minimum 8 characters</small>
					</div>
					
					<div>
						<input type="submit" value="Create Account"/>
					</div>
				</form>

				<div class="auth-footer">
					<p>Already have an account? <a href="/user/login">Sign in</a></p>
				</div>
			</div>
		</div>
	</div>
}