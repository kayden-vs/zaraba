package pages

import "github.com/kayden-vs/zaraba/ui/html"
import "strings"
import "fmt"

type CoinMarketProps struct {
	ID        string  `json:"id"`
	Symbol    string  `json:"symbol"`
	Name      string  `json:"name"`
	Base      string  `json:"base"`
	Price     float64 `json:"current_price"`
	Volume    float64 `json:"total_volume"`
	Change24h float64 `json:"price_change_percentage_24h"`
}

templ MarketsPage(symbols []CoinMarketProps, flash string, isAuthenticated bool, csrfToken string) {
    @html.Base("Markets", flash, isAuthenticated, csrfToken, MarketsBody(symbols))
}

templ MarketsBody(symbols []CoinMarketProps) {
    <div class="markets-container">
        <div class="markets-header">
            <h1>Markets</h1>
            <div class="markets-search">
                <input type="text" id="market-search" placeholder="Search markets..." autocomplete="off"/>
            </div>
        </div>

        <div class="market-filters">
            <button class="filter-tab active" data-filter="all">All</button>
            <button class="filter-tab" data-filter="gainers">Top Gainers</button>
            <button class="filter-tab" data-filter="losers">Top Losers</button>
        </div>

        if symbols != nil && len(symbols) > 0 {
            <div class="ft-table">
                <!-- Header -->
                <div class="ft-header">
                    <div class="ft-col ft-col-market">Market</div>
                    <div class="ft-col">Price</div>
                    <div class="ft-col">24h Change</div>
                    <div class="ft-col">24h Volume</div>
                    <div class="ft-col ft-col-action"></div>
                </div>

                <!-- Rows -->
                <div id="markets-tbody">
                    for i, symbol := range symbols {
                        <a href={ templ.SafeURL("/trade/" + strings.ToLower(symbol.ID)) }
                           class="ft-row market-row"
                           data-symbol={ strings.ToLower(symbol.ID) }
                           data-change={ fmt.Sprintf("%.4f", symbol.Change24h) }
                           style={ fmt.Sprintf("animation-delay: %dms", i*40) }>

                            <!-- Market -->
                            <div class="ft-col ft-col-market">
                                <div class="ft-symbol-icon">{ getSymbolInitial(symbol.Symbol) }</div>
                                <div class="ft-symbol-info">
                                    <div class="ft-symbol-name">{ symbol.Name }</div>
                                    <div class="ft-symbol-ticker">{ strings.ToUpper(symbol.Symbol) }/USDT</div>
                                </div>
                            </div>

                            <!-- Price -->
                            <div class="ft-col">
                                <span class="ft-price price-cell mono">${ fmt.Sprintf("%.2f", symbol.Price) }</span>
                            </div>

                            <!-- 24h Change -->
                            <div class="ft-col">
                                if symbol.Change24h >= 0 {
                                    <span class="ft-badge ft-badge--positive">+{ fmt.Sprintf("%.2f", symbol.Change24h) }%</span>
                                } else {
                                    <span class="ft-badge ft-badge--negative">{ fmt.Sprintf("%.2f", symbol.Change24h) }%</span>
                                }
                            </div>

                            <!-- Volume -->
                            <div class="ft-col">
                                <span class="ft-value mono">{ FormatNumberShort(symbol.Volume) }</span>
                            </div>

                            <!-- Action -->
                            <div class="ft-col ft-col-action">
                                <span class="ft-trade-btn">Trade
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                                </span>
                            </div>
                        </a>
                    }
                </div>
            </div>
        } else {
            <div class="empty-state">
                <p>No markets available at the moment.</p>
            </div>
        }
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('market-search');
            const filterTabs = document.querySelectorAll('.filter-tab');

            function getRows() {
                return document.querySelectorAll('.market-row');
            }

            // Search functionality
            searchInput.addEventListener('input', function() {
                const searchTerm = this.value.toLowerCase();
                getRows().forEach(function(row) {
                    var symbol = row.dataset.symbol;
                    var text = row.textContent.toLowerCase();
                    row.style.display = (text.includes(searchTerm) || symbol.includes(searchTerm)) ? '' : 'none';
                });
            });

            // Filter tabs
            filterTabs.forEach(function(tab) {
                tab.addEventListener('click', function() {
                    filterTabs.forEach(function(t) { t.classList.remove('active'); });
                    this.classList.add('active');
                    var filter = this.dataset.filter;
                    getRows().forEach(function(row) {
                        var change = parseFloat(row.dataset.change);
                        row.style.display = '';
                        if (filter === 'gainers' && change < 0) row.style.display = 'none';
                        else if (filter === 'losers' && change >= 0) row.style.display = 'none';
                    });
                });
            });

            // SSE live updates
            var previousPrices = new Map();
            getRows().forEach(function(row) {
                var priceEl = row.querySelector('.price-cell');
                if (priceEl) {
                    previousPrices.set(row.dataset.symbol, parseFloat(priceEl.textContent.replace('$', '')));
                }
            });

            var es = new EventSource('/sse/markets');
            es.onmessage = function(event) {
                var symbols = JSON.parse(event.data);
                symbols.forEach(function(sym) {
                    var id = sym.id.toLowerCase();
                    var row = document.querySelector('.market-row[data-symbol="' + id + '"]');
                    if (!row) return;

                    var priceEl = row.querySelector('.price-cell');
                    var newPrice = sym.current_price;
                    var oldPrice = previousPrices.get(id);

                    if (oldPrice !== undefined && oldPrice !== newPrice) {
                        priceEl.classList.remove('price-flash-up', 'price-flash-down');
                        void priceEl.offsetWidth;
                        priceEl.classList.add(newPrice > oldPrice ? 'price-flash-up' : 'price-flash-down');
                    }
                    priceEl.textContent = '$' + newPrice.toFixed(2);
                    previousPrices.set(id, newPrice);

                    // Update change badge
                    var change = sym.price_change_percentage_24h;
                    var badge = row.querySelector('.ft-badge');
                    badge.className = 'ft-badge ' + (change >= 0 ? 'ft-badge--positive' : 'ft-badge--negative');
                    badge.textContent = (change >= 0 ? '+' : '') + change.toFixed(2) + '%';

                    // Update data-change for filters
                    row.dataset.change = change.toFixed(4);

                    // Update volume
                    var vol = sym.total_volume;
                    var volStr = vol >= 1e12 ? (vol/1e12).toFixed(2) + 'T' :
                                 vol >= 1e9  ? (vol/1e9).toFixed(2) + 'B' :
                                 vol >= 1e6  ? (vol/1e6).toFixed(2) + 'M' :
                                               (vol/1e3).toFixed(2) + 'K';
                    row.querySelector('.ft-value').textContent = volStr;
                });
            };
            es.onerror = function() {
                console.log('SSE connection lost, browser will auto-reconnect...');
            };
        });
    </script>
}

func getSymbolInitial(symbol string) string {
    if len(symbol) > 0 {
        return strings.ToUpper(string(symbol[0]))
    }
    return "?"
}

func FormatNumberShort(n float64) string {
	switch {
	case n >= 1e12:
		return fmt.Sprintf("%.2fT", n/1e12)
	case n >= 1e9:
		return fmt.Sprintf("%.2fB", n/1e9)
	case n >= 1e6:
		return fmt.Sprintf("%.2fM", n/1e6)
	case n >= 1e3:
		return fmt.Sprintf("%.2fK", n/1e3)
	default:
		return fmt.Sprintf("%.2f", n)
	}
}
