package pages

import "github.com/kayden-vs/zaraba/ui/html"
import "strings"
import "fmt"

type CoinMarketProps struct {
	ID        string  `json:"id"`
	Symbol    string  `json:"symbol"`
	Name      string  `json:"name"`
	Base      string  `json:"base"`
	Price     float64 `json:"current_price"`
	Volume    float64 `json:"total_volume"`
	Change24h float64 `json:"price_change_percentage_24h"`
}

templ MarketsPage(symbols []CoinMarketProps, flash string, isAuthenticated bool, csrfToken string) {
    @html.Base("Markets", flash, isAuthenticated, csrfToken, MarketsBody(symbols))
}

templ MarketsBody(symbols []CoinMarketProps) {
    <div class="markets-container">
        <div class="markets-header">
            <h1>Markets</h1>
            <div class="markets-search">
                <input type="text" id="market-search" placeholder="Search markets..." autocomplete="off"/>
            </div>
        </div>

        <div class="market-filters">
            <button class="filter-tab active" data-filter="all">All</button>
            <button class="filter-tab" data-filter="gainers">Top Gainers</button>
            <button class="filter-tab" data-filter="losers">Top Losers</button>
        </div>

        if symbols != nil && len(symbols) > 0 {
            <div class="markets-table">
                <table>
                    <thead>
                        <tr>
                            <th>Market</th>
                            <th>Price</th>
                            <th>24h Change</th>
                            <th>24h Volume</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="markets-tbody">
                        for _, symbol := range symbols {
                            <tr class="clickable market-row" data-symbol={ strings.ToLower(symbol.ID) } data-change={ fmt.Sprintf("%.4f", symbol.Change24h) }>
                                <td>
                                    <a href={ templ.SafeURL("/trade/" + strings.ToLower(symbol.ID)) }>
                                        <div class="symbol-cell">
                                            <div class="symbol-icon">{ getSymbolInitial(symbol.Symbol) }</div>
                                            <div>
                                                <div class="symbol-name">{ symbol.Name }</div>
                                                <div class="symbol-ticker">{ strings.ToUpper(symbol.Symbol) }/USDT</div>
                                            </div>
                                        </div>
                                    </a>
                                </td>
                                <td class="price-cell mono">${ fmt.Sprintf("%.2f", symbol.Price) }</td>
                                if symbol.Change24h >= 0 {
                                    <td class="change-cell positive mono">+{ fmt.Sprintf("%.2f", symbol.Change24h) }%</td>
                                } else {
                                    <td class="change-cell negative mono">{ fmt.Sprintf("%.2f", symbol.Change24h) }%</td>
                                }
                                <td class="volume-cell mono">{ FormatNumberShort(symbol.Volume) }</td>
                                <td>
                                    <a href={ templ.SafeURL("/trade/" + strings.ToLower(symbol.ID)) } class="btn btn-sm btn-ghost">Trade</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        } else {
            <div class="empty-state">
                <p>No markets available at the moment.</p>
            </div>
        }
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('market-search');
            const rows = document.querySelectorAll('.market-row');
            const filterTabs = document.querySelectorAll('.filter-tab');
            
            // Search functionality
            searchInput.addEventListener('input', function() {
                const searchTerm = this.value.toLowerCase();
                rows.forEach(row => {
                    const symbol = row.dataset.symbol;
                    const text = row.textContent.toLowerCase();
                    if (text.includes(searchTerm) || symbol.includes(searchTerm)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            });

            // Filter tabs
            filterTabs.forEach(tab => {
                tab.addEventListener('click', function() {
                    filterTabs.forEach(t => t.classList.remove('active'));
                    this.classList.add('active');
                    
                    const filter = this.dataset.filter;
                    rows.forEach(row => {
                        const change = parseFloat(row.dataset.change);
                        row.style.display = '';
                        
                        if (filter === 'gainers' && change < 0) {
                            row.style.display = 'none';
                        } else if (filter === 'losers' && change >= 0) {
                            row.style.display = 'none';
                        }
                    });
                });
            });

            // Row click navigation
            rows.forEach(row => {
                row.addEventListener('click', function(e) {
                    if (e.target.tagName !== 'A' && e.target.tagName !== 'BUTTON') {
                        window.location.href = '/trade/' + this.dataset.symbol;
                    }
                });
            });

            // WebSocket - Track previous prices for flash effect
            const previousPrices = new Map();
            
            // Initialize previous prices from current page data
            rows.forEach(row => {
                const priceCell = row.querySelector('.price-cell');
                if (priceCell) {
                    const priceText = priceCell.textContent.replace('$', '');
                    const price = parseFloat(priceText);
                    previousPrices.set(row.dataset.symbol, price);
                }
            });

            const ws = new WebSocket('ws://' + window.location.host + '/ws');
            
            ws.onopen = function() {
                console.log('WebSocket connected');
            };

            ws.onmessage = function(event) {
                const symbols = JSON.parse(event.data);
                console.log('Received', symbols.length, 'symbols');
                
                symbols.forEach(symbol => {
                    const symbolId = symbol.id.toLowerCase();
                    const row = document.querySelector(`tr[data-symbol="${symbolId}"]`);
                    if (!row) {
                        console.log('Row not found for:', symbolId);
                        return;
                    }
                    
                    const priceCell = row.querySelector('.price-cell');
                    const newPrice = symbol.current_price;
                    const oldPrice = previousPrices.get(symbolId);
                    
                    console.log(symbolId, 'old:', oldPrice, 'new:', newPrice);
                    
                    // Update price with flash effect
                    if (oldPrice !== undefined && oldPrice !== newPrice) {
                        // Remove any existing flash classes
                        priceCell.classList.remove('price-flash-up', 'price-flash-down');
                        
                        // Trigger reflow to restart animation
                        void priceCell.offsetWidth;
                        
                        // Add appropriate flash class
                        if (newPrice > oldPrice) {
                            priceCell.classList.add('price-flash-up');
                            console.log(symbolId, 'FLASH GREEN');
                        } else if (newPrice < oldPrice) {
                            priceCell.classList.add('price-flash-down');
                            console.log(symbolId, 'FLASH RED');
                        }
                    }
                    
                    priceCell.textContent = '$' + newPrice.toFixed(2);
                    previousPrices.set(symbolId, newPrice);
                    
                    // Update 24h change
                    const change = symbol.price_change_percentage_24h;
                    const changeCell = row.querySelector('.change-cell');
                    changeCell.className = 'change-cell mono ' + (change >= 0 ? 'positive' : 'negative');
                    changeCell.textContent = (change >= 0 ? '+' : '') + change.toFixed(2) + '%';
                    
                    // Update volume
                    const volume = symbol.total_volume;
                    row.querySelector('.volume-cell').textContent = 
                        volume >= 1e9 ? (volume/1e9).toFixed(2) + 'B' :
                        volume >= 1e6 ? (volume/1e6).toFixed(2) + 'M' : 
                        (volume/1e3).toFixed(2) + 'K';
                });
            };

            // Reconnect if connection drops
            ws.onclose = () => setTimeout(() => location.reload(), 3000);
        });
    </script>
}

func getSymbolInitial(symbol string) string {
    if len(symbol) > 0 {
        return strings.ToUpper(string(symbol[0]))
    }
    return "?"
}

func FormatNumberShort(n float64) string {
	switch {
	case n >= 1e12:
		return fmt.Sprintf("%.2fT", n/1e12)
	case n >= 1e9:
		return fmt.Sprintf("%.2fB", n/1e9)
	case n >= 1e6:
		return fmt.Sprintf("%.2fM", n/1e6)
	case n >= 1e3:
		return fmt.Sprintf("%.2fK", n/1e3)
	default:
		return fmt.Sprintf("%.2f", n)
	}
}
