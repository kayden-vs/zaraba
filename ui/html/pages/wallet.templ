package pages

import "github.com/kayden-vs/zaraba/ui/html"
import "github.com/kayden-vs/zaraba/internal/engine"

templ WalletPage(Totalbalance int64, LockedAmount int64, flash string, isAuthenticated bool, csrfToken string) {
    @html.Base("Wallet", flash, isAuthenticated, csrfToken, WalletContent(Totalbalance, LockedAmount, csrfToken))
}

templ WalletContent(balance, LockedAmount int64, csrfToken string){
    <div class="wallet-container">
        <div class="wallet-header">
            <h1>Wallet</h1>
            <p>Manage your funds and track your portfolio</p>
        </div>

        <div class="balance-cards">
            <div class="balance-card primary">
                <span class="label">Total Balance</span>
                <div>
                    <span class="amount mono">{ engine.FormatPrice(balance) }</span>
                    <span class="currency">USDT</span>
                </div>
            </div>
            <div class="balance-card">
                <span class="label">Available</span>
                <div>
                    <span class="amount mono">{ engine.FormatPrice(balance - LockedAmount) }</span>
                    <span class="currency">USDT</span>
                </div>
            </div>
            <div class="balance-card locked">
                <span class="label">In Orders</span>
                <div>
                    <span class="amount mono">{ engine.FormatPrice(LockedAmount) }</span>
                    <span class="currency">USDT</span>
                </div>
            </div>
        </div>

        <div class="wallet-actions">
            <a href="#funds-section" class="wallet-action-btn primary" onclick="switchTab('deposit')">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Deposit
            </a>
            <a href="#funds-section" class="wallet-action-btn withdraw" onclick="switchTab('withdraw')">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Withdraw
            </a>
            <a href="/trade/bitcoin" class="wallet-action-btn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                    <polyline points="17 6 23 6 23 12"></polyline>
                </svg>
                Trade
            </a>
            <a href="/orders" class="wallet-action-btn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
                Orders
            </a>
        </div>

        <!-- Funds Section: Deposit & Withdraw -->
        <div id="funds-section" class="funds-panel mt-8">
            <div class="funds-tabs" role="tablist">
                <button class="funds-tab active" data-tab="deposit" onclick="switchTab('deposit')" role="tab" aria-selected="true">
                    <span class="funds-tab-icon deposit-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 5v14M5 12h14"></path>
                        </svg>
                    </span>
                    Deposit
                </button>
                <button class="funds-tab" data-tab="withdraw" onclick="switchTab('withdraw')" role="tab" aria-selected="false">
                    <span class="funds-tab-icon withdraw-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 7l-10 10M7 7h10v10"></path>
                        </svg>
                    </span>
                    Withdraw
                </button>
            </div>

            <!-- Deposit Panel -->
            <div class="funds-body" id="deposit-panel" role="tabpanel">
                <form method="POST" action="/api/wallet/transactions" class="funds-form">
                    <input type="hidden" name="csrf_token" value={ csrfToken } />
                    <input type="hidden" name="type" value="deposit" />
                    <div class="funds-amount-section">
                        <div class="funds-amount-header">
                            <label for="depositAmount" class="funds-label">Deposit Amount</label>
                            <span class="funds-currency-badge">USDT</span>
                        </div>
                        <div class="funds-input-box">
                            <span class="funds-dollar">$</span>
                            <input 
                                type="number" 
                                id="depositAmount" 
                                name="amount" 
                                step="0.01" 
                                min="1" 
                                placeholder="0.00"
                                required
                                class="funds-amount-input"
                                autocomplete="off"
                            />
                        </div>
                    </div>
                    <div class="funds-quick-amounts">
                        <button type="button" class="funds-chip" onclick="setAmount('depositAmount', 10)">$10</button>
                        <button type="button" class="funds-chip" onclick="setAmount('depositAmount', 50)">$50</button>
                        <button type="button" class="funds-chip" onclick="setAmount('depositAmount', 100)">$100</button>
                        <button type="button" class="funds-chip" onclick="setAmount('depositAmount', 500)">$500</button>
                        <button type="button" class="funds-chip" onclick="setAmount('depositAmount', 1000)">$1k</button>
                    </div>
                    <div class="slide-btn slide-btn--deposit" data-slide-btn data-form="deposit">
                        <div class="slide-btn__track"></div>
                        <div class="slide-btn__fill"></div>
                        <div class="slide-btn__label">
                            Slide to Deposit
                            <span class="slide-btn__chevrons">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                            </span>
                        </div>
                        <div class="slide-btn__thumb">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        </div>
                        <div class="slide-btn__status">
                            <svg class="spinner" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
                        </div>
                    </div>
                    <p class="funds-fine-print">Minimum deposit: $1.00</p>
                </form>
            </div>

            <!-- Withdraw Panel -->
            <div class="funds-body hidden" id="withdraw-panel" data-available={ engine.FormatPrice(balance - LockedAmount) } role="tabpanel">
                <form method="POST" action="/api/wallet/transactions" class="funds-form">
                    <input type="hidden" name="csrf_token" value={ csrfToken } />
                    <input type="hidden" name="type" value="withdraw" />
                    <div class="funds-balance-strip">
                        <span>Available</span>
                        <span class="mono">{ engine.FormatPrice(balance - LockedAmount) } USDT</span>
                    </div>
                    <div class="funds-amount-section">
                        <div class="funds-amount-header">
                            <label for="withdrawAmount" class="funds-label">Withdraw Amount</label>
                            <span class="funds-currency-badge">USDT</span>
                        </div>
                        <div class="funds-input-box">
                            <span class="funds-dollar">$</span>
                            <input 
                                type="number" 
                                id="withdrawAmount" 
                                name="amount" 
                                step="0.01" 
                                min="1" 
                                placeholder="0.00"
                                required
                                class="funds-amount-input"
                                autocomplete="off"
                            />
                        </div>
                    </div>
                    <div class="funds-quick-amounts">
                        <button type="button" class="funds-chip" onclick="setPercent(25)">25%</button>
                        <button type="button" class="funds-chip" onclick="setPercent(50)">50%</button>
                        <button type="button" class="funds-chip" onclick="setPercent(75)">75%</button>
                        <button type="button" class="funds-chip funds-chip-max" onclick="setPercent(100)">Max</button>
                    </div>
                    <div class="slide-btn slide-btn--withdraw" data-slide-btn data-form="withdraw">
                        <div class="slide-btn__track"></div>
                        <div class="slide-btn__fill"></div>
                        <div class="slide-btn__label">
                            Slide to Withdraw
                            <span class="slide-btn__chevrons">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                            </span>
                        </div>
                        <div class="slide-btn__thumb">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        </div>
                        <div class="slide-btn__status">
                            <svg class="spinner" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
                        </div>
                    </div>
                    <p class="funds-fine-print">Minimum withdrawal: $1.00</p>
                </form>
            </div>
        </div>

        <script>
            function switchTab(tab) {
                document.querySelectorAll('.funds-tab').forEach(function(t) {
                    t.classList.remove('active');
                    t.setAttribute('aria-selected', 'false');
                });
                var active = document.querySelector('.funds-tab[data-tab="' + tab + '"]');
                active.classList.add('active');
                active.setAttribute('aria-selected', 'true');
                document.getElementById('deposit-panel').classList.toggle('hidden', tab !== 'deposit');
                document.getElementById('withdraw-panel').classList.toggle('hidden', tab !== 'withdraw');
            }
            function setAmount(inputId, val) {
                document.getElementById(inputId).value = val.toFixed(2);
            }
            function setPercent(pct) {
                var raw = document.getElementById('withdraw-panel').getAttribute('data-available');
                var num = parseFloat(raw.replace(/,/g, ''));
                if (isNaN(num) || num < 0) num = 0;
                var amt = (num * pct / 100);
                document.getElementById('withdrawAmount').value = amt.toFixed(2);
            }

            // Slide-to-confirm buttons
            (function() {
                var THRESHOLD = 0.88;

                document.querySelectorAll('[data-slide-btn]').forEach(function(btn) {
                    var thumb = btn.querySelector('.slide-btn__thumb');
                    var fill  = btn.querySelector('.slide-btn__fill');
                    var form  = btn.closest('form');
                    var dragging = false;
                    var startX = 0;
                    var currentX = 0;
                    var maxDrag = 0;
                    var completed = false;

                    function getMaxDrag() {
                        return btn.offsetWidth - thumb.offsetWidth - 6;
                    }

                    function setPosition(x) {
                        thumb.style.transform = 'translateY(-50%) translateX(' + x + 'px)';
                        fill.style.width = (x + thumb.offsetWidth / 2) + 'px';
                    }

                    function springBack() {
                        thumb.classList.add('animate-back');
                        fill.classList.add('animate-back');
                        setPosition(0);
                        setTimeout(function() {
                            thumb.classList.remove('animate-back');
                            fill.classList.remove('animate-back');
                        }, 450);
                    }

                    function onStart(clientX) {
                        if (completed) return;
                        dragging = true;
                        startX = clientX;
                        maxDrag = getMaxDrag();
                        thumb.classList.remove('animate-back');
                        fill.classList.remove('animate-back');
                        fill.style.transition = 'none';
                    }

                    function onMove(clientX) {
                        if (!dragging || completed) return;
                        var dx = clientX - startX;
                        currentX = Math.max(0, Math.min(dx, maxDrag));
                        setPosition(currentX);
                    }

                    function onEnd() {
                        if (!dragging || completed) return;
                        dragging = false;
                        var progress = maxDrag > 0 ? currentX / maxDrag : 0;

                        if (progress >= THRESHOLD) {
                            completed = true;
                            setPosition(maxDrag);
                            btn.classList.add('is-completed');
                            // Submit the form
                            if (form) form.submit();
                        } else {
                            currentX = 0;
                            springBack();
                        }
                    }

                    // Mouse events
                    thumb.addEventListener('mousedown', function(e) {
                        e.preventDefault();
                        onStart(e.clientX);
                    });
                    window.addEventListener('mousemove', function(e) {
                        onMove(e.clientX);
                    });
                    window.addEventListener('mouseup', function() {
                        onEnd();
                    });

                    // Touch events
                    thumb.addEventListener('touchstart', function(e) {
                        onStart(e.touches[0].clientX);
                    }, { passive: true });
                    window.addEventListener('touchmove', function(e) {
                        onMove(e.touches[0].clientX);
                    }, { passive: true });
                    window.addEventListener('touchend', function() {
                        onEnd();
                    });
                });
            })();
        </script>

        <!-- Portfolio summary section -->
        <div class="card mt-8">
            <div class="card-header">
                <h3>Portfolio Summary</h3>
            </div>
            <div class="card-body">
                <table>
                    <thead>
                        <tr>
                            <th>Asset</th>
                            <th>Available</th>
                            <th>In Orders</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <div class="symbol-cell">
                                    <div class="symbol-icon">U</div>
                                    <div>
                                        <div class="symbol-name">Tether</div>
                                        <div class="symbol-ticker">USDT</div>
                                    </div>
                                </div>
                            </td>
                            <td class="mono">{ engine.FormatPrice(balance - LockedAmount) }</td>
                            <td class="mono text-tertiary">{ engine.FormatPrice(LockedAmount) }</td>
                            <td class="mono font-medium">{ engine.FormatPrice(balance) }</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}