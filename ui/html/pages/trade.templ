package pages

import "github.com/kayden-vs/zaraba/ui/html"
import "strings"
import "fmt"
import "github.com/kayden-vs/zaraba/internal/engine"

templ TradePage(symbol CoinMarketProps ,tvSymbol string ,walletBalance int64, flash string, isAuthenticated bool, csrfToken string) {
    @html.Base(symbol.Name, flash, isAuthenticated, csrfToken, TradePageBody(symbol, tvSymbol, walletBalance))
}

templ TradePageBody(symbol CoinMarketProps, tvSymbol string, walletBalance int64) {
    <div class="trade-layout">
        <!-- Trade Header with Market Info -->
        <div class="heading">
            <div class="symbol-info">
                <span class="symbol-name">{ strings.ToUpper(symbol.Name) }/USDT</span>
            </div>
            <div class="symbol-price mono">
                ${ fmt.Sprintf("%.2f", symbol.Price) }
            </div>
            if symbol.Change24h >= 0 {
                <span class="price-change positive">+{ fmt.Sprintf("%.2f", symbol.Change24h) }%</span>
            } else {
                <span class="price-change negative">{ fmt.Sprintf("%.2f", symbol.Change24h) }%</span>
            }
        </div>

        <!-- TradingView Chart -->
        <div class="tradingview-widget-container">
            <div class="tradingview-widget-container__widget"></div>
            <script type="text/javascript" src="https://s3.tradingview.com/external-embedding/embed-widget-advanced-chart.js" async>
            {
                "allow_symbol_change": true,
                "calendar": false,
                "details": false,
                "hide_side_toolbar": true,
                "hide_top_toolbar": false,
                "hide_legend": false,
                "hide_volume": false,
                "hotlist": false,
                "interval": "15",
                "locale": "en",
                "save_image": true,
                "style": "1",
                "symbol": {{ tvSymbol }},
                "theme": "dark",
                "timezone": "Asia/Kolkata",
                "backgroundColor": "#111113",
                "gridColor": "rgba(255, 255, 255, 0.04)",
                "watchlist": [],
                "withdateranges": false,
                "compareSymbols": [],
                "studies": [],
                "width": "100%",
                "height": "100%"
            }
            </script>
        </div>

        <!-- Market Data Column: Orderbook + Recent Trades -->
        <div class="market-data">
            <!-- Orderbook Panel -->
            <div class="orderbook">
                <div class="orderbook-header">
                    <h3>Order Book</h3>
                </div>
                <div class="orderbook-cols">
                    <span>Price (USDT)</span>
                    <span>Size</span>
                    <span>Total</span>
                </div>
                <div class="orderbook-asks">
                    <!-- Sell orders (asks) - populated by websocket -->
                    <div class="orderbook-row ask">
                        <span class="price">--</span>
                        <span class="size">--</span>
                        <span class="total">--</span>
                    </div>
                </div>
                <div class="orderbook-spread">
                    <span>Spread</span>
                    <span class="spread-value">--</span>
                </div>
                <div class="orderbook-bids">
                    <!-- Buy orders (bids) - populated by websocket -->
                    <div class="orderbook-row bid">
                        <span class="price">--</span>
                        <span class="size">--</span>
                        <span class="total">--</span>
                    </div>
                </div>
            </div>

            <!-- Recent Trades Panel -->
            <div class="recent-trades">
                <div class="recent-trades-header">
                    <h3>Recent Trades</h3>
                </div>
                <div class="trades-cols">
                    <span>Price</span>
                    <span>Size</span>
                    <span>Time</span>
                </div>
                <div class="trades-list">
                    <!-- Trade history - populated by websocket -->
                    <div class="trade-row">
                        <span class="price">--</span>
                        <span class="size">--</span>
                        <span class="time">--</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Trade Panel (Order Form) -->
        <div class="trade-panel" id="trade-panel">
            <div class="trade-panel-header">
                <div class="order-type-toggle">
                    <button class="toggle-btn active" data-side="buy" type="button">Buy</button>
                    <button class="toggle-btn" data-side="sell" type="button">Sell</button>
                </div>
            </div>

            <div class="trade-panel-body">
                <!-- Order Type Selection -->
                <div class="order-type-selector">
                    <label class="radio-option">
                        <input type="radio" name="orderType" value="limit" checked/>
                        <span>Limit</span>
                    </label>
                    <label class="radio-option">
                        <input type="radio" name="orderType" value="market"/>
                        <span>Market</span>
                    </label>
                </div>

                <!-- Available Margin Display -->
                <div class="margin-info">
                    <span class="label">Available Balance</span>
                    <span class="value mono" id="available-margin">{ engine.FormatPrice(walletBalance) } USDT</span>
                </div>

                <!-- Price Input (only for limit orders) -->
                <div class="input-group limit-only">
                    <label for="price">Price</label>
                    <div class="input-wrapper">
                        <input type="number" id="price" placeholder="0.00" step="0.01"/>
                        <span class="input-suffix">USDT</span>
                    </div>
                </div>

                <!-- Amount Input -->
                <div class="input-group">
                    <label for="amount">Amount</label>
                    <div class="input-wrapper">
                        <input type="number" id="amount" placeholder="0.00" step="0.00000001"/>
                        <span class="input-suffix">{ strings.ToUpper(symbol.Name) }</span>
                    </div>
                </div>

                <!-- Percentage Buttons -->
                <div class="percentage-buttons">
                    <button class="percent-btn" data-percent="25" type="button">25%</button>
                    <button class="percent-btn" data-percent="50" type="button">50%</button>
                    <button class="percent-btn" data-percent="75" type="button">75%</button>
                    <button class="percent-btn" data-percent="100" type="button">100%</button>
                </div>

                <!-- Total Display -->
                <div class="total-info">
                    <span class="label">Total</span>
                    <span class="value mono" id="total-amount">0.00 USDT</span>
                </div>

                <!-- Action Button -->
                if walletBalance == 0 {
                    <a href="/user/wallet" class="action-btn add-funds-btn">
                        Add Funds to Trade
                    </a>
                } else {
                    <button class="action-btn buy-btn" id="place-order-btn" type="button">
                        Buy { strings.ToUpper(symbol.Name) }
                    </button>
                }
            </div>

            <!-- Trade History Link -->
            <a href="/orders" class="trade-history-link">
                View Trade History
            </a>
        </div>
    </div>

    <script>
        // Trade Panel Interactivity
        (function() {
            document.addEventListener('DOMContentLoaded', function() {
                // Data from Go template
                const availableMargin = {{ fmt.Sprintf("%.2f", float64(walletBalance)/100) }};
                const currentPrice = {{ fmt.Sprintf("%.2f", symbol.Price) }};
                const symbolName = '{{ strings.ToUpper(symbol.Name) }}';

                const tradePanel = document.getElementById('trade-panel');
                const buyBtn = document.querySelector('[data-side="buy"]');
                const sellBtn = document.querySelector('[data-side="sell"]');
                const placeOrderBtn = document.getElementById('place-order-btn');
                const orderTypeRadios = document.querySelectorAll('input[name="orderType"]');
                const priceInput = document.getElementById('price');
                const amountInput = document.getElementById('amount');
                const limitOnlyGroup = document.querySelector('.limit-only');
                const percentButtons = document.querySelectorAll('.percent-btn');
                const totalDisplay = document.getElementById('total-amount');
                
                let currentSide = 'buy';
                let currentOrderType = 'limit';

                // Buy/Sell Toggle with smooth color transition
                if (buyBtn) {
                    buyBtn.addEventListener('click', function() {
                        currentSide = 'buy';
                        buyBtn.classList.add('active');
                        sellBtn.classList.remove('active');
                        tradePanel.classList.remove('sell-mode');
                        tradePanel.classList.add('buy-mode');
                        if (placeOrderBtn) {
                            placeOrderBtn.className = 'action-btn buy-btn';
                            placeOrderBtn.textContent = 'Buy ' + symbolName;
                        }
                    });
                }

                if (sellBtn) {
                    sellBtn.addEventListener('click', function() {
                        currentSide = 'sell';
                        sellBtn.classList.add('active');
                        buyBtn.classList.remove('active');
                        tradePanel.classList.remove('buy-mode');
                        tradePanel.classList.add('sell-mode');
                        if (placeOrderBtn) {
                            placeOrderBtn.className = 'action-btn sell-btn';
                            placeOrderBtn.textContent = 'Sell ' + symbolName;
                        }
                    });
                }

                // Order Type Toggle (Limit/Market)
                orderTypeRadios.forEach(function(radio) {
                    radio.addEventListener('change', function() {
                        currentOrderType = this.value;
                        if (currentOrderType === 'market') {
                            limitOnlyGroup.style.display = 'none';
                        } else {
                            limitOnlyGroup.style.display = 'flex';
                        }
                        calculateTotal();
                    });
                });

                // Percentage Buttons
                percentButtons.forEach(function(btn) {
                    btn.addEventListener('click', function() {
                        // Remove active state from all
                        percentButtons.forEach(function(b) { b.classList.remove('active'); });
                        this.classList.add('active');
                        
                        const percent = parseFloat(this.dataset.percent);
                        const price = currentOrderType === 'limit' ? (parseFloat(priceInput.value) || currentPrice) : currentPrice;
                        if (price > 0) {
                            const amount = (availableMargin * percent / 100) / price;
                            amountInput.value = amount.toFixed(8);
                            calculateTotal();
                        }
                    });
                });

                // Calculate Total
                function calculateTotal() {
                    const amount = parseFloat(amountInput.value) || 0;
                    const price = currentOrderType === 'limit' ? (parseFloat(priceInput.value) || 0) : currentPrice;
                    const total = amount * price;
                    if (totalDisplay) {
                        totalDisplay.textContent = total.toFixed(2) + ' USDT';
                    }
                }

                // Update total on input change
                if (priceInput) {
                    priceInput.addEventListener('input', function() {
                        percentButtons.forEach(function(b) { b.classList.remove('active'); });
                        calculateTotal();
                    });
                }
                if (amountInput) {
                    amountInput.addEventListener('input', function() {
                        percentButtons.forEach(function(b) { b.classList.remove('active'); });
                        calculateTotal();
                    });
                }

                // Set initial price for limit orders
                if (priceInput && currentPrice > 0) {
                    priceInput.value = currentPrice.toFixed(2);
                }

                // Initialize buy mode
                if (tradePanel) {
                    tradePanel.classList.add('buy-mode');
                }
            });
        })();
    </script>
}