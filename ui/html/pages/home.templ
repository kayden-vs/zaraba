package pages 

import "github.com/kayden-vs/zaraba/ui/html"

templ HomePage(flash string, isAuthenticated bool, csrfToken string) {
    @html.Base("Home", flash, isAuthenticated, csrfToken, HomeContent())
}

templ HomeContent() {
    <div class="auth-container">
        <div class="text-center" style="max-width: 600px;">
            <h1 class="text-3xl font-semibold mb-4">Welcome to Zaraba</h1>
            <p class="text-secondary text-lg mb-8">A professional cryptocurrency exchange platform for traders who demand precision and reliability.</p>
            <div class="flex gap-4 justify-center">
                <a href="/markets" class="btn btn-primary btn-lg">Explore Markets</a>
                <a href="/user/signup" class="btn btn-lg">Get Started</a>
            </div>
        </div>
    </div>
}