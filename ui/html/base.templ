package html 

import "github.com/kayden-vs/zaraba/ui/html/partials"

templ Base(title string, flash string, isAuthenticated bool, csrfToken string, body templ.Component) {
    <!DOCTYPE html>
    <html lang='en'>
    <head>
        <meta charset='utf-8'>
        <meta name='viewport' content='width=device-width, initial-scale=1'>
        <meta name='theme-color' content='#0A0D12'>
        <title>{ title } - Zaraba</title>
        <link rel='icon' type='image/png' href='/static/images/logo.png'>
        <link rel='preconnect' href='https://fonts.googleapis.com'>
        <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin>
        <link href='https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Montserrat:wght@400;500;600;700&display=swap' rel='stylesheet'>
        <link rel='stylesheet' href='/static/css/main.css'>
    </head>
    <body>
        <div class="bg-pattern bg-pattern--dots bg-pattern--mask-fade-edges"></div>
        @partials.NavBar(isAuthenticated, csrfToken)
        <main class="animate-fade-in">
            @body
        </main>
        if flash != "" {
            <div class="toast-container" id="toast-container">
                <div class="toast" id="toast-flash" data-flash={ flash }>
                    <div class="toast-content">
                        <div class="toast-icon" id="toast-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                        </div>
                        <div class="toast-body">
                            <div class="toast-title" id="toast-title">Notification</div>
                            <div class="toast-description" id="toast-description">{ flash }</div>
                        </div>
                    </div>
                    <button class="toast-close" onclick="this.closest('.toast').classList.add('toast--exit'); setTimeout(function(){ var c = document.getElementById('toast-container'); if(c) c.remove(); }, 300)" aria-label="Close">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                    </button>
                </div>
            </div>
        }
        <script>
        (function() {
            var boneyard = (function() {
                var registry = new Map();

                function clamp(value, min, max) {
                    return Math.max(min, Math.min(max, value));
                }

                function createFallbackBones(container) {
                    var out = [];
                    var width = container.clientWidth || 320;
                    var y = 14;
                    for (var i = 0; i < 8; i++) {
                        var rowWidth = Math.max(120, Math.floor(width * (0.5 + Math.random() * 0.42)));
                        out.push({
                            x: 12,
                            y: y,
                            w: rowWidth,
                            h: 12,
                            r: 8,
                            round: i % 3 === 0
                        });
                        y += 22;
                    }
                    return out;
                }

                function collectBones(container) {
                    var rect = container.getBoundingClientRect();
                    if (rect.width < 8 || rect.height < 8) {
                        return [];
                    }

                    var nodes = container.querySelectorAll(
                        'h1,h2,h3,h4,p,small,span,label,strong,b,a,button,input,th,td,.ft-row,.orderbook-row,.trade-row,.balance-card,.auth-field,.landing-feature-card,.landing-marquee__item'
                    );

                    var bones = [];
                    for (var i = 0; i < nodes.length; i++) {
                        var node = nodes[i];
                        var box = node.getBoundingClientRect();
                        if (box.width < 10 || box.height < 8) {
                            continue;
                        }
                        if (box.width > rect.width * 0.96 && box.height > rect.height * 0.96) {
                            continue;
                        }
                        var top = box.top - rect.top;
                        var left = box.left - rect.left;

                        bones.push({
                            x: clamp(left, 0, rect.width - 8),
                            y: clamp(top, 0, rect.height - 8),
                            w: clamp(box.width, 20, rect.width - left),
                            h: clamp(box.height, 10, 34),
                            r: Math.min(10, Math.max(4, box.height / 2.5)),
                            round: node.tagName === 'BUTTON' || node.tagName === 'INPUT'
                        });

                        if (bones.length >= 64) {
                            break;
                        }
                    }

                    return bones.length ? bones : createFallbackBones(container);
                }

                function mount(selector, options) {
                    var cfg = options || {};
                    var el = document.querySelector(selector);
                    if (!el || registry.has(selector)) {
                        return;
                    }

                    var bones = collectBones(el);
                    if (!bones.length) {
                        return;
                    }

                    el.classList.add('boneyard-zone');
                    el.dataset.boneyardState = 'loading';

                    var overlay = document.createElement('div');
                    overlay.className = 'boneyard-overlay';

                    bones.forEach(function(bone) {
                        var n = document.createElement('span');
                        n.className = 'boneyard-bone ' + (bone.round ? 'boneyard-bone--round' : 'boneyard-bone--soft');
                        n.style.left = bone.x + 'px';
                        n.style.top = bone.y + 'px';
                        n.style.width = bone.w + 'px';
                        n.style.height = bone.h + 'px';
                        n.style.borderRadius = bone.r + 'px';
                        overlay.appendChild(n);
                    });

                    el.appendChild(overlay);

                    var entry = {
                        el: el,
                        overlay: overlay,
                        fallbackTimer: null
                    };
                    registry.set(selector, entry);

                    if (cfg.autoRevealDelay && cfg.autoRevealDelay > 0) {
                        setTimeout(function() {
                            reveal(selector);
                        }, cfg.autoRevealDelay);
                    }

                    if (cfg.fallbackRevealDelay && cfg.fallbackRevealDelay > 0) {
                        entry.fallbackTimer = setTimeout(function() {
                            reveal(selector);
                        }, cfg.fallbackRevealDelay);
                    }
                }

                function reveal(selector) {
                    var entry = registry.get(selector);
                    if (!entry) {
                        return;
                    }

                    if (entry.fallbackTimer) {
                        clearTimeout(entry.fallbackTimer);
                    }

                    entry.el.dataset.boneyardState = 'ready';

                    setTimeout(function() {
                        if (entry.overlay && entry.overlay.parentNode) {
                            entry.overlay.parentNode.removeChild(entry.overlay);
                        }
                        entry.el.classList.remove('boneyard-zone');
                        delete entry.el.dataset.boneyardState;
                        registry.delete(selector);
                    }, 280);
                }

                function mountDefaults() {
                    mount('.landing-hero__content', { autoRevealDelay: 720, fallbackRevealDelay: 2400 });
                    mount('.landing-globe__canvas-wrap', { fallbackRevealDelay: 3600 });
                    mount('.auth-form-section', { autoRevealDelay: 420, fallbackRevealDelay: 1600 });
                    mount('.account-card', { autoRevealDelay: 340, fallbackRevealDelay: 1400 });
                    mount('.wallet-container .balance-cards', { autoRevealDelay: 420, fallbackRevealDelay: 1600 });
                    mount('.markets-container .ft-table', { autoRevealDelay: 380, fallbackRevealDelay: 1800 });
                    mount('.tradingview-widget-container', { fallbackRevealDelay: 7000 });
                    mount('.orderbook', { fallbackRevealDelay: 7000 });
                    mount('.recent-trades', { fallbackRevealDelay: 7000 });
                    mount('.nf-empty', { autoRevealDelay: 300, fallbackRevealDelay: 1200 });
                }

                function watchDynamicReadiness() {
                    var tvWidget = document.querySelector('.tradingview-widget-container__widget');
                    if (tvWidget) {
                        var tvObserver = new MutationObserver(function() {
                            if (tvWidget.querySelector('iframe')) {
                                reveal('.tradingview-widget-container');
                                tvObserver.disconnect();
                            }
                        });
                        tvObserver.observe(tvWidget, { childList: true, subtree: true });
                    }

                    var globeCanvas = document.getElementById('globe-canvas');
                    if (globeCanvas) {
                        var unveilGlobe = function() {
                            if (globeCanvas.width > 0 && globeCanvas.height > 0) {
                                reveal('.landing-globe__canvas-wrap');
                                return true;
                            }
                            return false;
                        };

                        if (!unveilGlobe()) {
                            var globeChecks = 0;
                            var globeTimer = setInterval(function() {
                                globeChecks += 1;
                                if (unveilGlobe() || globeChecks > 20) {
                                    clearInterval(globeTimer);
                                }
                            }, 180);
                        }
                    }
                }

                return {
                    mount: mount,
                    reveal: reveal,
                    mountDefaults: mountDefaults,
                    watchDynamicReadiness: watchDynamicReadiness
                };
            })();

            window.zarabaBoneyard = boneyard;

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', function() {
                    boneyard.mountDefaults();
                    boneyard.watchDynamicReadiness();
                });
            } else {
                boneyard.mountDefaults();
                boneyard.watchDynamicReadiness();
            }

            // Magnetic button effect
            var DISTANCE = 0.6;
            var wraps = document.querySelectorAll('.magnetic-wrap');
            wraps.forEach(function(el) {
                var hovered = false;
                el.addEventListener('mouseenter', function() { hovered = true; });
                el.addEventListener('mouseleave', function() {
                    hovered = false;
                    el.style.transform = 'translate(0px, 0px)';
                });
                document.addEventListener('mousemove', function(e) {
                    if (!hovered) return;
                    var rect = el.getBoundingClientRect();
                    var cx = rect.left + rect.width / 2;
                    var cy = rect.top + rect.height / 2;
                    var dx = (e.clientX - cx) * DISTANCE;
                    var dy = (e.clientY - cy) * DISTANCE;
                    el.style.transform = 'translate(' + dx + 'px, ' + dy + 'px)';
                });
            });

            var toast = document.getElementById('toast-flash');
            if (toast) {
                var toastTitle = document.getElementById('toast-title');
                var toastDescription = document.getElementById('toast-description');
                var toastIcon = document.getElementById('toast-icon');
                var rawFlash = toast.getAttribute('data-flash') || '';

                var typeMap = {
                    success: {
                        title: 'Success',
                        icon: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>'
                    },
                    error: {
                        title: 'Error',
                        icon: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>'
                    },
                    warning: {
                        title: 'Warning',
                        icon: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3l-8.47-14.14a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>'
                    },
                    info: {
                        title: 'Info',
                        icon: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>'
                    }
                };

                var flashType = 'info';
                var flashMessage = rawFlash;
                var flashSep = rawFlash.indexOf(':');
                if (flashSep > 0) {
                    var maybeType = rawFlash.slice(0, flashSep).toLowerCase();
                    if (typeMap[maybeType]) {
                        flashType = maybeType;
                        flashMessage = rawFlash.slice(flashSep + 1);
                    }
                }

                toast.classList.add('toast--' + flashType);
                if (toastTitle && typeMap[flashType]) {
                    toastTitle.textContent = typeMap[flashType].title;
                }
                if (toastDescription) {
                    toastDescription.textContent = flashMessage;
                }
                if (toastIcon && typeMap[flashType]) {
                    toastIcon.innerHTML = typeMap[flashType].icon;
                }

                // Toast auto-dismiss after 5s
                setTimeout(function() {
                    toast.classList.add('toast--exit');
                    setTimeout(function() {
                        var c = document.getElementById('toast-container');
                        if (c) c.remove();
                    }, 300);
                }, 5000);
            }

            // Avatar color initialization
            document.querySelectorAll('.avatar[data-color]').forEach(function(el) {
                el.style.backgroundColor = el.dataset.color;
            });

            // Profile popover toggle
            var popoverWrap = document.querySelector('.profile-popover-wrap');
            if (popoverWrap) {
                var trigger = popoverWrap.querySelector('.avatar-trigger');
                var popover = popoverWrap.querySelector('.popover');
                var backdrop = document.getElementById('popover-backdrop');

                function openPopover() {
                    popover.classList.add('is-open');
                    if (backdrop) backdrop.classList.add('is-open');
                }
                function closePopover() {
                    popover.classList.remove('is-open');
                    if (backdrop) backdrop.classList.remove('is-open');
                }

                trigger.addEventListener('click', function(e) {
                    e.stopPropagation();
                    if (popover.classList.contains('is-open')) {
                        closePopover();
                    } else {
                        openPopover();
                    }
                });

                if (backdrop) {
                    backdrop.addEventListener('click', closePopover);
                }

                document.addEventListener('click', function(e) {
                    if (!popoverWrap.contains(e.target)) {
                        closePopover();
                    }
                });

                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape') closePopover();
                });
            }

        })();
        </script>
    </body>
    </html>
}